# ── LLM 厂牌 ────────────────────────────────────────────────────────────
# 支持的厂牌：deepseek / openai / qwen / glm / moonshot / ollama
# 留空或不设置则默认 deepseek。
LLM_PROVIDER=deepseek

# 通用 API key；未设置时回退到 DEEPSEEK_API_KEY（向后兼容）
LLM_API_KEY=

# 以下为显式覆盖项，留空则从厂牌预置取默认值
# LLM 模型名（留空 = 厂牌默认模型）
LLM_MODEL=
# API 端点 base_url（留空 = 厂牌默认端点）
LLM_BASE_URL=
# JSON mode 校验/解析失败最大重试次数（默认 2，不含首次尝试）
LLM_MAX_RETRIES=2

# DeepSeek API key（向后兼容；建议新项目使用 LLM_API_KEY）
DEEPSEEK_API_KEY=

# 数据库：Supabase Postgres 连接串
# 形如 postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=

# ── Embedding（SQLite 后端不需要；仅 Postgres/pgvector 路径使用）────────
# 支持的厂牌：siliconflow / openai / qwen / glm / ollama
# 留空或不设置则默认 siliconflow。
# EMBEDDING_PROVIDER=siliconflow

# Embedding API key
# EMBEDDING_API_KEY=

# 以下为显式覆盖项，留空则从厂牌预置取默认值
# EMBEDDING_MODEL=
# EMBEDDING_BASE_URL=
# EMBEDDING_DIMS=1024
# EMBEDDING_MAX_RETRIES=2
